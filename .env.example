# ---------------------------------------------------------------------------
# businessfind — environment variables
#
# Copy this file to `.env` and fill in your own values:
#
#     cp .env.example .env
#
# `.env` holds REAL keys and is excluded from commits via .gitignore.
# This file (.env.example) carries no values, so it is safe to commit.
# ---------------------------------------------------------------------------

# REQUIRED — the Nominatim and Overpass usage policies require a descriptive
# User-Agent containing contact details. The tool stops if this is empty.
CONTACT_EMAIL=

# TomTom Search API key — https://developer.tomtom.com (no credit card needed)
# 2,500 free requests per day. To run without it: --skip-tomtom
TOMTOM_API_KEY=
