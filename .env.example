# ---------------------------------------------------------------------------
# leadgen — ortam degiskenleri
#
# Bu dosyayi `.env` olarak kopyalayin ve kendi degerlerinizi girin:
#
#     cp .env.example .env
#
# `.env` GERCEK anahtarlari tutar ve .gitignore ile commit disi birakilmistir.
# Bu dosya (.env.example) deger icermedigi icin guvenle commit edilebilir.
# ---------------------------------------------------------------------------

# ZORUNLU — Nominatim ve Overpass kullanim politikasi, iletisim bilgisi iceren
# aciklayici bir User-Agent sart kosuyor. Bos birakirsaniz script durur.
CONTACT_EMAIL=

# TomTom Search API anahtari — https://developer.tomtom.com (kredi karti istemez)
# Gunde 2.500 ucretsiz istek. Kullanmayacaksaniz: --skip-tomtom
TOMTOM_API_KEY=

# LangSearch Web Search API anahtari — https://langsearch.com (kredi karti istemez)
# Kullanmayacaksaniz: --skip-langsearch
LANGSEARCH_API_KEY=
